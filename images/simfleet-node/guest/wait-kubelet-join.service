[Unit]
Description=Configure kubelet from the DPF join Secret
ConditionPathExists=/etc/dpf-sim/mgmt.kubeconfig
After=network-online.target cloud-final.service containerd.service
Wants=network-online.target
# Deliberately not ordered against mock-dpuagent.service. DPF only publishes
# the join Secret after it has driven this guest's Redfish BMC, so delaying
# the mock on this unit would deadlock provisioning. Both steps are
# idempotent and the mock retries its own kubelet start.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
# The helper waits as long as the agent needs to reach Configure Kubelet,
# which the fleet's phase delays can stretch to hours. It bounds only its
# retries on failed reads and exits non-zero so systemd owns those.
TimeoutStartSec=0
ExecStart=/opt/dpf/wait-kubelet-join.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=cloud-init.target
